{
  "info": {
    "_postman_id": "a91b4528-76c2-48a0-9c1e-3f789d2cbb54",
    "name": "API-Development Practice (Sun Asterisk)",
    "description": "Bộ sưu tập kiểm thử API RESTful đầy đủ: Authentication, Products CRUD, Request/Response cycles, và Test Scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Welcome Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "    console.log('Saved JWT Token to collection variables!');",
                  "}",
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sun-asterisk.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyen Van A\",\n  \"email\": \"user_demo@sun-asterisk.com\",\n  \"password\": \"UserDemo@123\",\n  \"role\": \"trainee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Get Profile (Me) - Needs Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products (CRUD & Filtering)",
      "item": [
        {
          "name": "Get Products (Paginated & Filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?page=1&limit=5&category=laptops&sort=price_desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" },
                { "key": "category", "value": "laptops" },
                { "key": "sort", "value": "price_desc" }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "1"]
            }
          }
        },
        {
          "name": "Create Product (Protected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sony WH-1000XM5 Wireless Headphones\",\n  \"category\": \"accessories\",\n  \"price\": 399,\n  \"stock\": 30,\n  \"description\": \"Tai nghe chống ồn đỉnh cao hàng đầu thị trường.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          }
        },
        {
          "name": "Update Product Full (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"MacBook Pro 16 inch M3 Max (Updated)\",\n  \"category\": \"laptops\",\n  \"price\": 3299,\n  \"stock\": 20,\n  \"description\": \"Phiên bản nâng cấp giá ưu đãi.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "1"]
            }
          }
        },
        {
          "name": "Update Product Partial (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 2999,\n  \"stock\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "1"]
            }
          }
        },
        {
          "name": "Delete Product (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "5"]
            }
          }
        }
      ]
    }
  ]
}
